<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surfaceDark">

    <FrameLayout
        android:id="@+id/viewerHost"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_canvas_card"
        android:clipToPadding="false"
        android:padding="1dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <com.sikkatu.sikkatucad.DxfCanvasView
            android:id="@+id/dxfCanvasView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/infoScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/infoContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp" />
        </ScrollView>

        <LinearLayout
            android:id="@+id/emptyPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_empty_panel"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="34dp"
                android:paddingEnd="24dp"
                android:paddingBottom="34dp">

                <ImageView
                    android:layout_width="200dp"
                    android:layout_height="156dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_sikkatu_logo_large"
                    android:scaleType="fitCenter" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:text="@string/empty_hint"
                    android:textColor="@color/textOnDark"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/empty_subtitle"
                    android:textColor="@color/textMutedOnDark"
                    android:textSize="13sp" />
                    <com.google.android.material.button.MaterialButton
                    android:id="@+id/reopenFileButton"
                    style="@style/Cad.PrimaryActionButton"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginTop="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/reopen_last"
                    android:textColor="@color/textOnDark"
                    app:backgroundTint="@color/accentStrong"
                    app:icon="@android:drawable/ic_menu_view"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconTint="@color/textOnDark"
                    android:visibility="gone" />
                <com.google.android.material.button.MaterialButton
                android:id="@+id/languageButton"
                    style="@style/Cad.PrimaryActionButton"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginTop="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/language_picker"
                    android:textColor="@color/textOnDark"
                    app:backgroundTint="@color/navItemBg"
                    app:icon="@android:drawable/ic_menu_mapmode"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconTint="@color/textOnDark" />
            </LinearLayout>
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/overlayPanelScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/overlayPanel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/autoDimensionChip"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_overlay_chip"
                    android:gravity="center"
                    android:minWidth="54dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/chip_auto_dimension"
                    android:textColor="@color/textOnDark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/view2dChip"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_overlay_chip"
                    android:gravity="center"
                    android:minWidth="46dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/chip_view_2d"
                    android:textColor="@color/textOnDark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/view3dChip"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_overlay_chip"
                    android:gravity="center"
                    android:minWidth="46dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/chip_view_3d"
                    android:textColor="@color/textOnDark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/bevelChip"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_overlay_chip"
                    android:gravity="center"
                    android:minWidth="54dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/chip_bevel"
                    android:textColor="@color/textOnDark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/rapidChip"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_overlay_chip"
                    android:gravity="center"
                    android:minWidth="54dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/chip_rapid"
                    android:textColor="@color/textOnDark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/fileTypeChip"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:background="@null"
                    android:gravity="center"
                    android:minWidth="44dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/file_type_unknown"
                    android:textColor="@color/textOnDark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/metaChip"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:background="@null"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/file_type_unknown"
                    android:textColor="@color/textOnDark"
                    android:textSize="12sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/ncConsole"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_gravity="bottom"
            android:layout_margin="14dp"
            android:background="@drawable/bg_nc_console"
            android:elevation="10dp"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/nc_code_title"
                android:textColor="@color/textOnDark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ScrollView
                android:id="@+id/ncConsoleScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:background="#0A0F18"
                android:overScrollMode="never">

                <TextView
                    android:id="@+id/ncConsoleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="2dp"
                    android:padding="8dp"
                    android:textColor="#E5EAF2"
                    android:textSize="12sp"
                    android:typeface="monospace" />
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGenNcPreview"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/generate_nc"
                    android:textColor="@color/textOnDark" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:background="@drawable/bg_top_bar"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_cad_badge" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/fileNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/no_file"
                android:textColor="@color/textOnDark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/status_idle"
                android:textColor="@color/textMutedOnDark"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/openButton"
            style="@style/Cad.PrimaryActionButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:contentDescription="@string/open_file"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/open_file"
            android:textColor="@color/textOnDark"
            android:textSize="13sp"
            app:backgroundTint="@color/accentStrong"
            app:icon="@android:drawable/ic_menu_upload"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconSize="18dp"
            app:iconTint="@color/textOnDark" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sidePanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_side_panel"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingTop="2dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintWidth_percent="0.54">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/sideTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/panel_default"
                android:textColor="@color/textPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/panelClose"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="@string/close_panel"
                android:gravity="center"
                android:text="×"
                android:textColor="@color/textSecondary"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/sideContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="14dp" />
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:background="@drawable/bg_bottom_bar"
        android:elevation="12dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="7dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/actionFile"
            style="@style/Cad.BottomNavButton"
            android:text="@string/action_file"
            app:icon="@android:drawable/ic_menu_upload" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/actionLayers"
            style="@style/Cad.BottomNavButton"
            android:text="@string/action_layers"
            app:icon="@android:drawable/ic_menu_sort_by_size" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/actionMeasure"
            style="@style/Cad.BottomNavButton"
            android:text="@string/action_measure"
            app:icon="@android:drawable/ic_menu_crop" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/actionTexts"
            style="@style/Cad.BottomNavButton"
            android:text="@string/action_texts"
            app:icon="@android:drawable/ic_menu_edit" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/actionSettings"
            style="@style/Cad.BottomNavButton"
            android:text="@string/action_settings"
            app:icon="@android:drawable/ic_menu_manage" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>